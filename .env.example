# Copy this file to .env. Never put secrets in index.html or commit .env.
PORT=8787
HOST=127.0.0.1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_me
AI_MODEL=gpt-4.1-mini

# Set a long random token before exposing the backend beyond localhost.
APP_ACCESS_TOKEN=replace_with_a_long_random_token
